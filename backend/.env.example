DATABASE_URL="postgresql://user:password@localhost:5432/studenthub?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
# In production this MUST be your real domain(s) — do not leave it open.
CORS_ORIGINS="http://localhost:5173"

# SMTP — used for password reset emails, 2FA login codes, and approval
# notices. Leave blank for local development: emails will be printed to the
# backend console instead of actually sent, so you can still test the flows.
# Fill these in with a real provider (your school's mail server, SendGrid,
# Mailgun, Amazon SES, etc.) before using this for real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StudentHub <no-reply@studenthub.local>"
